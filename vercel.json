{
  "functions": {
    "api/**/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "redirects": [
    { "source": "/", "destination": "/client/index.html", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/client/:page(admin|admin-audit|admin-fares|admin-landmarks|admin-users).php",
      "destination": "/api/pages/:page.php"
    }
  ]
}
