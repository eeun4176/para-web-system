{
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "redirects": [
    { "source": "/", "destination": "/client/index.html", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/client/:page(admin|admin-audit|admin-fares|admin-landmarks|admin-users|admin-settings).php",
      "destination": "/api/index.php?__route=pages/:page"
    },
    {
      "source": "/api/:route(.+)\\.php",
      "destination": "/api/index.php?__route=:route"
    }
  ]
}
